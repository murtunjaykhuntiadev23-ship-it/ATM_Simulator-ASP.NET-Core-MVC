<h2>Change PIN</h2>

@if (ViewBag.Error != null)
{
    <div class="text-danger mb-2">@ViewBag.Error</div>
}

<form method="post">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label>Old PIN</label>
        <input type="password" name="oldPin" maxlength="4" class="form-control" style="max-width:200px" />
    </div>
    <div class="mb-3">
        <label>New PIN (4 digits)</label>
        <input type="password" name="newPin" maxlength="4" class="form-control" style="max-width:200px" />
    </div>
    <div class="mb-3">
        <label>Confirm New PIN</label>
        <input type="password" name="confirmPin" maxlength="4" class="form-control" style="max-width:200px" />
    </div>
    <button type="submit" class="btn btn-warning">Change PIN</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>